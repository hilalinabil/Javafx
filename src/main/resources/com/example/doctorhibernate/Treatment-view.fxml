<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="900.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.doctorhibernate.controller.TreatmentController">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" BorderPane.alignment="CENTER">
            <children>
                <Label text="Treatment Management">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="300.0" spacing="15.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label text="Treatment Details" textFill="#2563eb">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Separator prefWidth="200.0" />

                <VBox spacing="5.0">
                    <children>
                        <Label text="Treatment Type" />
                        <ComboBox fx:id="comboType" maxWidth="1.7976931348623157E308" promptText="Select Type..." />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Description" />
                        <TextField fx:id="txtDescription" promptText="e.g., Root Canal" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Cost ($)" />
                        <TextField fx:id="txtCost" promptText="0.00" />
                    </children>
                </VBox>

                <Pane VBox.vgrow="ALWAYS" />

                <VBox spacing="10.0">
                    <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onSave" styleClass="btn-primary" text="Save Treatment" />
                        <HBox spacing="10.0">
                            <children>
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onUpdate" styleClass="btn-warning" text="Update" HBox.hgrow="ALWAYS" />
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onDelete" styleClass="btn-danger" text="Delete" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="15.0" styleClass="main-content" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
                    <children>
                        <Label text="Filter by Type:">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="filterComboType" prefWidth="150.0" promptText="All Types" />
                        <Button mnemonicParsing="false" onAction="#onClearFilter" styleClass="btn-outline" text="Clear Filter" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                    </padding>
                </HBox>

                <TableView fx:id="treatmentTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" maxWidth="80.0" minWidth="50.0" text="ID" />
                        <TableColumn fx:id="colType" prefWidth="120.0" text="Type" />
                        <TableColumn fx:id="colDesc" prefWidth="200.0" text="Description" />
                        <TableColumn fx:id="colCost" maxWidth="120.0" minWidth="80.0" text="Cost" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>