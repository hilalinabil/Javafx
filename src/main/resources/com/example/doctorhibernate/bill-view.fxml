<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.doctorhibernate.controller.BillController"
            stylesheets="@styles.css">

    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="Billing System" styleClass="header-title"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" styleClass="main-content">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card">
                <Label text="Generate Bill For:"/>
                <ComboBox fx:id="patientCombo" promptText="Select Patient" prefWidth="250"/>
                <Button text="Generate Invoice" styleClass="btn-primary" onAction="#handleGenerateBill"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalLabel" text="Total: $0.00" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </HBox>

            <TableView fx:id="billTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="Bill ID" prefWidth="60"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
                    <TableColumn fx:id="colPatient" text="Patient CIN" prefWidth="100"/>
                    <TableColumn fx:id="colRoom" text="Room" prefWidth="80"/>
                    <TableColumn fx:id="colTotal" text="Total ($)" prefWidth="100"/>
                    <TableColumn fx:id="colPaid" text="Status" prefWidth="80"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>