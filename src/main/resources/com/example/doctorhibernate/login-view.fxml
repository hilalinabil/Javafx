<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane styleClass="login-bg" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.doctorhibernate.controller.LoginController">
    <children>
        <VBox alignment="CENTER" maxWidth="450.0" spacing="24.0" styleClass="login-card">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
            <children>
                <VBox alignment="CENTER" spacing="8.0">
                    <children>
                        <Label text="🏥" textFill="#2563eb">
                            <font>
                                <Font size="48.0" />
                            </font>
                        </Label>
                        <Label styleClass="login-title" text="MedNexus" />
                        <Label styleClass="login-subtitle" text="Hospital Management System" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="16.0" />
                    </VBox.margin>
                </VBox>

                <VBox spacing="16.0">
                    <children>
                        <VBox spacing="8.0">
                             <Label styleClass="text-secondary" text="Username" />
                             <TextField fx:id="usernameField" promptText="Enter your username" />
                        </VBox>
                        
                        <VBox spacing="8.0">
                             <Label styleClass="text-secondary" text="Password" />
                             <PasswordField fx:id="passwordField" promptText="Enter your password" />
                        </VBox>
                    </children>
                </VBox>

                <Button maxWidth="Infinity" defaultButton="true" onAction="#handleLoginButton" styleClass="btn-primary" text="Sign In" />
                
                <Label fx:id="errorLabel" styleClass="status-danger" visible="false" wrapText="true" />
            </children>
        </VBox>
    </children>
</StackPane>