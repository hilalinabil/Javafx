<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="700.0" minWidth="1100.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.doctorhibernate.controller.PatientController">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" BorderPane.alignment="CENTER">
            <children>
                <Label text="Patient Registration &amp; Management">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
        </HBox>
    </top>

    <left>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefWidth="350.0" styleClass="sidebar-scroll" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="12.0" styleClass="sidebar">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label text="Personal Information" textFill="#2563eb">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Separator prefWidth="200.0" />

                        <HBox spacing="10.0">
                            <children>
                                <VBox HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="First Name" />
                                        <TextField fx:id="firstNameField" promptText="John" />
                                    </children>
                                </VBox>
                                <VBox HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Last Name" />
                                        <TextField fx:id="lastNameField" promptText="Doe" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="CIN (ID Number)" />
                                <TextField fx:id="cinField" promptText="AB123456" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Email" />
                                <TextField fx:id="emailField" promptText="john.doe@example.com" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Phone" />
                                <TextField fx:id="phoneField" promptText="+212 6..." />
                            </children>
                        </VBox>

                        <Label text="Medical &amp; Assignment" textFill="#2563eb">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </Label>
                        <Separator prefWidth="200.0" />

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Allergies / Notes" />
                                <TextArea fx:id="allergiesField" prefHeight="60.0" promptText="Peanuts, Penicillin..." wrapText="true" />
                            </children>
                        </VBox>

                        <HBox spacing="10.0">
                            <children>
                                <VBox HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Assign Room" />
                                        <ComboBox fx:id="roomCombo" maxWidth="1.7976931348623157E308" promptText="Select Room..." />
                                    </children>
                                </VBox>
                                <VBox HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Assign Doctor" />
                                        <ComboBox fx:id="doctorCombo" maxWidth="1.7976931348623157E308" promptText="Select Doctor..." />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Select Treatments (Hold Ctrl/Cmd to select multiple)" wrapText="true">
                                    <font>
                                        <Font size="11.0" />
                                    </font>
                                </Label>
                                <ListView fx:id="treatmentList" prefHeight="150.0" styleClass="checkbox-list-view" />
                            </children>
                        </VBox>

                        <Separator prefWidth="200.0">
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </Separator>

                        <HBox spacing="10.0">
                            <children>
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSaveButton" styleClass="btn-primary" text="✓ Register Patient" HBox.hgrow="ALWAYS" />
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDelete" styleClass="btn-danger" text="🗑 Delete Selected" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </left>

    <center>
        <VBox spacing="15.0" styleClass="main-content" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <TableView fx:id="patientTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" maxWidth="50.0" minWidth="40.0" text="ID" />
                        <TableColumn fx:id="colFirstName" prefWidth="100.0" text="First Name" />
                        <TableColumn fx:id="colLastName" prefWidth="100.0" text="Last Name" />
                        <TableColumn fx:id="colCin" prefWidth="90.0" text="CIN" />
                        <TableColumn fx:id="colRoom" prefWidth="80.0" text="Room" />
                        <TableColumn fx:id="colDoctor" prefWidth="120.0" text="Doctor" />
                        <TableColumn fx:id="colTreatments" prefWidth="90.0" text="Treatments" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>