<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="1000.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.doctorhibernate.controller.PatientController">
    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="👤" style="-fx-font-size: 28px;">
                        <HBox.margin>
                            <Insets right="8.0" />
                        </HBox.margin>
                    </Label>
                    <VBox alignment="CENTER_LEFT">
                        <Label text="Patient Management" styleClass="header-title" />
                        <Label text="Register new patients and manage records" styleClass="header-subtitle">
                            <VBox.margin>
                                <Insets top="4.0" />
                            </VBox.margin>
                        </Label>
                    </VBox>
                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
            </padding>
        </HBox>
    </top>

    <!-- Sidebar Form -->
    <left>
        <ScrollPane fitToWidth="true" styleClass="sidebar-scroll" BorderPane.alignment="CENTER">
            <content>
                <VBox prefWidth="350.0" spacing="15.0" styleClass="card">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label text="Patient Details" textFill="#2563eb">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Separator prefWidth="200.0" />

                        <!-- Name Fields -->
                        <HBox spacing="10.0">
                             <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                                <Label text="First Name" />
                                <TextField fx:id="firstNameField" promptText="e.g. John" />
                             </VBox>
                             <VBox HBox.hgrow="ALWAYS" spacing="5.0">
                                <Label text="Last Name" />
                                <TextField fx:id="lastNameField" promptText="e.g. Doe" />
                             </VBox>
                        </HBox>

                        <VBox spacing="5.0">
                            <Label text="CIN (ID Number)" />
                            <TextField fx:id="cinField" promptText="ID Number" />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label text="Email Address" />
                            <TextField fx:id="emailField" promptText="patient@example.com" />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label text="Phone Number" />
                            <TextField fx:id="phoneField" promptText="+1 234..." />
                        </VBox>
                        
                        <VBox spacing="5.0">
                            <Label text="Allergies / Notes" />
                            <TextArea fx:id="allergiesField" prefHeight="60.0" promptText="Peanuts, Penicillin..." wrapText="true" />
                        </VBox>

                        <Separator prefWidth="200.0" />
                        <Label text="Medical Assignment" textFill="#2563eb">
                             <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <VBox spacing="5.0">
                            <Label text="Assign Room" />
                            <ComboBox fx:id="roomCombo" maxWidth="1.7976931348623157E308" promptText="Select Room..." />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label text="Assign Doctor" />
                            <ComboBox fx:id="doctorCombo" maxWidth="1.7976931348623157E308" promptText="Select Doctor..." />
                        </VBox>

                        <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Treatments" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button text="+ New" styleClass="btn-outline" onAction="#handleAddTreatment" style="-fx-font-size: 10px; -fx-padding: 2 6;"/>
                            </HBox>
                            <ListView fx:id="treatmentList" prefHeight="100.0" VBox.vgrow="ALWAYS" />
                            <Label text="* Hold Ctrl/Cmd to select multiple" style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" />
                        </VBox>

                        <VBox spacing="10.0">
                            <Button fx:id="saveButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSaveButton" styleClass="btn-primary" text="✓ Register Patient" />
                            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleClear" styleClass="btn-outline" text="Clear Form" />
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </left>

    <!-- Main Table -->
    <center>
        <VBox spacing="15.0" styleClass="main-content" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                   <Label text="Patient Directory" textFill="#6b7280" style="-fx-font-weight: bold;"/>
                   <Region HBox.hgrow="ALWAYS" />
                   <Button text="Delete Selected" onAction="#handleDelete" styleClass="btn-danger" />
                </HBox>

                <TableView fx:id="patientTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" maxWidth="60.0" minWidth="40.0" text="ID" />
                        <TableColumn fx:id="colFirstName" prefWidth="100.0" text="First Name" />
                        <TableColumn fx:id="colLastName" prefWidth="100.0" text="Last Name" />
                        <TableColumn fx:id="colCin" prefWidth="80.0" text="CIN" />
                        <TableColumn fx:id="colDoctor" prefWidth="120.0" text="Doctor" />
                        <TableColumn fx:id="colRoom" prefWidth="80.0" text="Room" />
                        <TableColumn fx:id="colTreatments" prefWidth="100.0" text="Treatments" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>
