<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="1000.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.doctorhibernate.controller.DoctorController">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" BorderPane.alignment="CENTER">
            <children>
                <Label text="Doctor Management">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
        </HBox>
    </top>

    <left>
        <ScrollPane fitToWidth="true" styleClass="sidebar-scroll" BorderPane.alignment="CENTER">
            <content>
                <VBox prefWidth="320.0" spacing="15.0" styleClass="sidebar">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label text="Doctor Details" textFill="#2563eb">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Separator prefWidth="200.0" />

                        <HBox spacing="10.0">
                            <children>
                                <VBox HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="First Name" />
                                        <TextField fx:id="firstNameField" promptText="Jane" />
                                    </children>
                                </VBox>
                                <VBox HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Last Name" />
                                        <TextField fx:id="lastNameField" promptText="Doe" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Email Address" />
                                <TextField fx:id="emailField" promptText="doctor@hospital.com" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Speciality" />
                                <TextField fx:id="specialityField" promptText="e.g. Cardiology" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="Department" />
                                <TextField fx:id="departmentField" promptText="e.g. Surgery Wing A" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <Label text="License Number" />
                                <TextField fx:id="licenseField" promptText="LIC-12345" />
                            </children>
                        </VBox>

                        <Pane VBox.vgrow="ALWAYS" minHeight="20.0" />

                        <VBox spacing="10.0">
                            <children>
                                <Button fx:id="saveButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSave" styleClass="btn-primary" text="✓ Save Doctor" />
                                <HBox spacing="10.0">
                                    <children>
                                        <Button fx:id="deleteButton" disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDelete" styleClass="btn-danger" text="Delete" HBox.hgrow="ALWAYS" />
                                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleClear" styleClass="btn-outline" text="Clear" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </left>

    <center>
        <VBox spacing="15.0" styleClass="main-content" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Label text="All Registered Doctors" textFill="#6b7280" style="-fx-font-weight: bold;"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                </HBox>

                <TableView fx:id="doctorTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMatr" maxWidth="60.0" minWidth="40.0" text="ID" />
                        <TableColumn fx:id="colFirstName" prefWidth="100.0" text="First Name" />
                        <TableColumn fx:id="colLastName" prefWidth="100.0" text="Last Name" />
                        <TableColumn fx:id="colEmail" prefWidth="150.0" text="Email" />
                        <TableColumn fx:id="colSpeciality" prefWidth="120.0" text="Speciality" />
                        <TableColumn fx:id="colDepartment" prefWidth="120.0" text="Dept." />
                        <TableColumn fx:id="colLicense" prefWidth="100.0" text="License" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>