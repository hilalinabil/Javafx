<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="900.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.doctorhibernate.controller.RoomController">

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header-bar" BorderPane.alignment="CENTER">
            <children>
                <Label text="Room Management">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>
            </children>
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="300.0" spacing="15.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label text="Room Details" textFill="#2563eb">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Separator prefWidth="200.0" />

                <VBox spacing="5.0">
                    <children>
                        <Label text="Room Number" />
                        <TextField fx:id="numberField" promptText="e.g., 101-A" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Room Type" />
                        <TextField fx:id="typeField" promptText="e.g., ICU, General Ward" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Capacity (Beds)" />
                        <Spinner fx:id="capacityField" maxWidth="1.7976931348623157E308" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Status" />
                        <CheckBox fx:id="occupiedCheck" mnemonicParsing="false" text="Currently Occupied" />
                    </children>
                </VBox>

                <Pane VBox.vgrow="ALWAYS" />

                <VBox spacing="10.0">
                    <children>
                        <Button fx:id="addUpdateButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAddOrUpdateRoom" styleClass="btn-primary" text="✓ Add Room" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onClear" styleClass="btn-outline" text="Clear Form" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="15.0" styleClass="main-content" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onRefresh" styleClass="btn-outline" text="🔄 Refresh List" />
                    </children>
                </HBox>

                <TableView fx:id="roomTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" maxWidth="60.0" minWidth="40.0" text="ID" />
                        <TableColumn fx:id="colNumber" prefWidth="100.0" text="Number" />
                        <TableColumn fx:id="colType" prefWidth="150.0" text="Type" />
                        <TableColumn fx:id="colCapacity" maxWidth="100.0" minWidth="80.0" style="-fx-alignment: CENTER;" text="Capacity" />
                        <TableColumn fx:id="colOccupied" prefWidth="120.0" text="Status" />
                        <TableColumn fx:id="colActions" minWidth="140.0" text="Actions" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>